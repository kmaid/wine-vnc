# Tray-only panel in the bottom-right corner, so Wine has somewhere to dock the Sync icon.

# Background 1: panel
rounded = 4
border_width = 0
background_color = #2b2b2b 100
border_color = #000000 0

panel_items = S
panel_position = bottom right horizontal
panel_size = 100% 40
panel_shrink = 1
panel_margin = 0 0
panel_padding = 6 4 6
panel_background_id = 1
panel_layer = top
panel_dock = 0
strut_policy = follow_size
wm_menu = 0
autohide = 0

systray_padding = 0 0 6
systray_background_id = 0
systray_sort = ascending
systray_icon_size = 32
systray_icon_asb = 100 0 0
systray_monitor = 1
